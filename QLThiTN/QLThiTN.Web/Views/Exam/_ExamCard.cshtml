@model ExamScheduleViewModel
@{
    var now = DateTime.Now;
    var isOpen = Model.StartTime <= now && Model.EndTime >= now;
}
<div class="card card-exam h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="subject-badge"><i class="bi bi-book me-1"></i>@Model.SubjectName</span>
            @if (Model.StartTime > now)
            {
                <span class="badge-status badge-status-warn"><i class="bi bi-hourglass-split me-1"></i>Sắp mở</span>
            }
            else if (Model.EndTime < now)
            {
                <span class="badge-status badge-status-muted"><i class="bi bi-stop-circle me-1"></i>Đã đóng</span>
            }
            else
            {
                <span class="badge-status badge-status-success"><i class="bi bi-play-circle me-1"></i>Đang mở</span>
            }
        </div>
        <div class="mb-2">
            <span class="badge-status badge-status-info"><i class="bi @Model.ExamKind.ToIcon() me-1"></i>@Model.ExamKind.ToDisplayName()</span>
            @if (Model.HasRegistered)
            {
                <span class="badge-status badge-status-success ms-1"><i class="bi bi-check2-circle me-1"></i>Đã đăng ký</span>
            }
        </div>
        <h5 class="card-title fw-bold mb-2">@Model.Title</h5>
        <p class="card-text text-muted small flex-grow-1">@Model.Description</p>
        <ul class="list-unstyled small text-muted mb-3">
            <li class="mb-1"><i class="bi bi-clock me-2"></i>Thời gian: @Model.Duration phút</li>
            <li class="mb-1"><i class="bi bi-calendar-check me-2"></i>Bắt đầu: @(Model.StartTime?.ToString("dd/MM/yyyy HH:mm") ?? "Sớm")</li>
            <li class="mb-1"><i class="bi bi-calendar-x me-2"></i>Kết thúc: @(Model.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</li>
            <li class="mb-1"><i class="bi bi-list-ol me-2"></i>@Model.QuestionCount câu hỏi</li>
            <li class="mb-1">
                <i class="bi bi-people me-2"></i>
                @if (Model.SoChoConLai.HasValue)
                {
                    <text>Còn <b>@Model.SoChoConLai.Value</b> chỗ (@Model.SoDangKy đã đăng ký)</text>
                }
                else if (Model.SoDangKy > 0)
                {
                    <text>@Model.SoDangKy lượt đăng ký</text>
                }
                else
                {
                    <text>Không giới hạn số lượng</text>
                }
            </li>
        </ul>
        @if (Model.HasRegistered && isOpen)
        {
            <a asp-controller="Exam" asp-action="Taking" asp-route-id="@Model.Id" class="btn btn-primary-custom mt-auto">
                <i class="bi bi-pencil-square me-1"></i>Vào thi ngay
            </a>
        }
        else if (Model.HasRegistered)
        {
            <a asp-controller="Exam" asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-primary-custom mt-auto">
                <i class="bi bi-eye me-1"></i>Xem chi tiết
            </a>
        }
        else
        {
            <a asp-controller="Exam" asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-primary-custom mt-auto">
                @if (isOpen)
                {
                    <text><i class="bi bi-person-plus me-1"></i>Đăng ký thi</text>
                }
                else
                {
                    <text><i class="bi bi-eye me-1"></i>Xem chi tiết</text>
                }
            </a>
        }
    </div>
</div>
