@model ExamHistoryViewModel
@{
    ViewData["Title"] = "Tra cứu kết quả";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap align-items-end justify-content-between mb-4 gap-3">
            <div>
                <h1 class="section-title mb-2"><i class="bi bi-search me-2"></i>Tra cứu kết quả thi</h1>
                <p class="section-subtitle mb-0">Xem lịch sử các kỳ thi đã tham gia, tra cứu điểm số và kết quả chi tiết từng bài thi</p>
            </div>
            @if (Model.Items.Any())
            {
                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchHistory" class="form-control" placeholder="Tìm theo tên kỳ thi / môn học..." aria-label="Tìm kiếm lịch sử thi">
                </div>
            }
        </div>

        @if (ViewBag.RequireLogin == true)
        {
            <div class="text-center py-5">
                <i class="bi bi-person-lock" style="font-size: 4rem; color: #01b4ff;"></i>
                <h5 class="mt-3 fw-bold">Vui lòng đăng nhập để xem lịch sử bài thi</h5>
                <p class="text-muted">Đăng nhập bằng tài khoản học viên để theo dõi điểm số và quá trình rèn luyện của bạn.</p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</a>
                    <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-calendar-event me-2"></i>Xem lịch thi</a>
                </div>
            </div>
        }
        else if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-clock-history" style="font-size: 4rem; color: #c3cbe0;"></i>
                <h5 class="mt-3 fw-bold text-muted">Bạn chưa tham gia kỳ thi nào</h5>
                <a asp-controller="Exam" asp-action="Schedule" class="btn btn-primary-custom mt-3"><i class="bi bi-calendar-event me-2"></i>Xem lịch thi</a>
            </div>
        }
        else
        {
            <!-- Analytics Cards & Charts -->
            var publishedScores = Model.Items.Where(i => i.ScorePublished).OrderBy(i => i.EndTime).ToList();
            var avgScore = publishedScores.Any() ? publishedScores.Average(i => i.Score) : 0;
            var maxScore = publishedScores.Any() ? publishedScores.Max(i => i.Score) : 0;

            if (publishedScores.Any())
            {
                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <div class="card border-0 rounded-4 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-primary me-2"></i>Biểu đồ phong độ điểm số</h6>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 small">@publishedScores.Count bài thi đã công bố điểm</span>
                                </div>
                                <div style="height: 220px; position: relative;">
                                    <canvas id="scoreHistoryChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card border-0 rounded-4 shadow-sm h-100">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-speedometer2 text-accent me-2"></i>Thống kê tổng quan</h6>
                                <div class="row g-3 text-center my-auto">
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded-4">
                                            <div class="fs-4 fw-bold text-primary">@avgScore.ToString("0.0#")</div>
                                            <small class="text-muted">Điểm trung bình</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded-4">
                                            <div class="fs-4 fw-bold text-success">@maxScore.ToString("0.0#")</div>
                                            <small class="text-muted">Điểm cao nhất</small>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded-4">
                                            <div class="fs-4 fw-bold text-dark">@Model.Items.Count</div>
                                            <small class="text-muted">Tổng số kỳ thi đã tham gia</small>
                                        </div>
                                    </div>
                                </div>
                                <small class="text-muted text-center mt-3"><i class="bi bi-shield-check text-success me-1"></i>Hệ thống tự động chấm điểm khách quan</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-exam mb-0 align-middle" id="resultTable">
                        <thead>
                            <tr>
                                <th>Kỳ thi</th>
                                <th>Loại kỳ thi</th>
                                <th>Môn học</th>
                                <th>Ngày thi</th>
                                <th class="text-center">Điểm số</th>
                                <th class="text-center">Xếp loại</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr data-search="@item.ExamTitle @item.SubjectName @item.ExamKindText">
                                    <td>
                                        <div class="fw-semibold">@item.ExamTitle</div>
                                        <small class="text-muted">@item.Duration phút • @item.StatusText</small>
                                    </td>
                                    <td><span class="badge-status badge-status-purple">@item.ExamKindText</span></td>
                                    <td><span class="subject-badge">@item.SubjectName</span></td>
                                    <td>@(item.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                    <td class="text-center">
                                        @if (item.ScorePublished)
                                        {
                                            <span class="fw-bold fs-6" style="color: var(--accent2);">@item.Score.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-status-warn">Chờ công bố</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.ScorePublished)
                                        {
                                            if (item.Score >= 8)
                                            {
                                                <span class="badge-status badge-status-success">Giỏi</span>
                                            }
                                            else if (item.Score >= 6.5m)
                                            {
                                                <span class="badge-status badge-status-info">Khá</span>
                                            }
                                            else if (item.Score >= 5)
                                            {
                                                <span class="badge-status badge-status-warn">Trung bình</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-danger">Yếu</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.ScorePublished)
                                        {
                                            <a asp-controller="Exam" asp-action="Result" asp-route-id="@item.ExamId" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-eye me-1"></i>Chi tiết</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Exam" asp-action="Detail" asp-route-id="@item.ExamId" class="btn btn-sm btn-outline-secondary rounded-pill px-3"><i class="bi bi-info-circle me-1"></i>Thông tin</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="text-muted small mt-3"><i class="bi bi-info-circle me-1"></i>Điểm chỉ được hiển thị khi trung tâm công bố điểm sớm cho kỳ thi.</p>
        }
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        $(function () {
            $('#searchHistory').on('keyup', function () {
                var q = $(this).val().toLowerCase().trim();
                $('#resultTable tbody tr').each(function () {
                    var hay = $(this).attr('data-search') || '';
                    $(this).toggle(hay.toLowerCase().indexOf(q) >= 0);
                });
            });

            // Vẽ biểu đồ điểm số bằng Chart.js
            var chartEl = document.getElementById('scoreHistoryChart');
            if (chartEl) {
                @if (Model.Items.Any(i => i.ScorePublished))
                {
                    var sortedPublished = Model.Items.Where(i => i.ScorePublished).OrderBy(i => i.EndTime).ToList();
                    var chartLabels = sortedPublished.Select(p => $"{(p.ExamTitle.Length > 20 ? p.ExamTitle.Substring(0, 18) + "..." : p.ExamTitle)} ({(p.EndTime?.ToString("dd/MM") ?? "")})").ToList();
                    var chartScores = sortedPublished.Select(p => p.Score).ToList();
                    @:var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels));
                    @:var scores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartScores));
                }
                else
                {
                    @:var labels = [];
                    @:var scores = [];
                }

                new Chart(chartEl, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Điểm thi',
                            data: scores,
                            borderColor: '#01b4ff',
                            backgroundColor: 'rgba(1, 180, 255, 0.1)',
                            borderWidth: 3,
                            pointBackgroundColor: '#7c4dff',
                            pointBorderColor: '#fff',
                            pointHoverRadius: 6,
                            pointRadius: 4,
                            tension: 0.3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                min: 0,
                                max: 10,
                                ticks: { stepSize: 2 }
                            },
                            x: {
                                ticks: {
                                    maxRotation: 45,
                                    minRotation: 0,
                                    font: { size: 10 }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}