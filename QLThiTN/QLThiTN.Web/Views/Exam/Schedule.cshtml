@model List<ExamScheduleViewModel>
@{
    ViewData["Title"] = "Lịch thi";
    var myExams = Model.Where(e => e.IsAssignedToMe || e.HasRegistered).ToList();
    var publicExams = Model.Where(e => e.IsPublic && !e.HasRegistered).ToList();
    var others = Model.Except(myExams.Concat(publicExams)).ToList();

    string StatusBadge(ExamScheduleViewModel exam)
    {
        if (exam.StartTime > DateTime.Now)
            return "<span class=\"badge-status\" style=\"background: rgba(255, 159, 67, .15); color: #b36200;\"><i class=\"bi bi-hourglass-split me-1\"></i>Sắp mở</span>";
        if (exam.EndTime < DateTime.Now)
            return "<span class=\"badge-status\" style=\"background: rgba(108, 117, 125, .15); color: #495057;\"><i class=\"bi bi-stop-circle me-1\"></i>Đã đóng</span>";
        return "<span class=\"badge-status\" style=\"background: rgba(40, 167, 69, .15); color: #1e7e34;\"><i class=\"bi bi-play-circle me-1\"></i>Đang mở</span>";
    }
}

<section class="py-5">
    <div class="container">
        <div class="mb-5">
            <h1 class="section-title mb-2"><i class="bi bi-calendar-event me-2"></i>Lịch thi</h1>
            <p class="section-subtitle mb-0">Lịch kiểm tra 15 phút, thi thử cuối tháng và các đợt thi thử THPT Quốc gia miễn phí</p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #c3cbe0;"></i>
                <h5 class="mt-3 fw-bold text-muted">Chưa có kỳ thi nào</h5>
                <p class="text-muted">Vui lòng quay lại sau!</p>
            </div>
        }
        else
        {
            @if (myExams.Any())
            {
                <h5 class="fw-bold text-uppercase small text-muted mb-3"><i class="bi bi-person-check me-1"></i>Kỳ thi của tôi</h5>
                <div class="row g-4 mb-5">
                    @foreach (var exam in myExams)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-exam h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="subject-badge"><i class="bi bi-book me-1"></i>@exam.SubjectName</span>
                                        @Html.Raw(StatusBadge(exam))
                                    </div>
                                    <div class="mb-2">
                                        <span class="badge-status" style="background: rgba(124, 77, 255, .12); color: #5e2fd4;"><i class="bi @exam.ExamKind.ToIcon() me-1"></i>@exam.ExamKind.ToDisplayName()</span>
                                    </div>
                                    <h5 class="card-title fw-bold mb-2">@exam.Title</h5>
                                    <p class="card-text text-muted small flex-grow-1">@exam.Description</p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li class="mb-1"><i class="bi bi-clock me-2"></i>Thời gian: @exam.Duration phút</li>
                                        <li class="mb-1"><i class="bi bi-calendar-check me-2"></i>Bắt đầu: @(exam.StartTime?.ToString("dd/MM/yyyy HH:mm") ?? "Sớm")</li>
                                        <li class="mb-1"><i class="bi bi-calendar-x me-2"></i>Kết thúc: @(exam.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</li>
                                        <li class="mb-1"><i class="bi bi-list-ol me-2"></i>@exam.QuestionCount câu hỏi</li>
                                    </ul>
                                    <a asp-controller="Exam" asp-action="Detail" asp-route-id="@exam.Id" class="btn btn-primary-custom mt-auto">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (publicExams.Any())
            {
                <h5 class="fw-bold text-uppercase small mb-3" style="color: var(--accent2);"><i class="bi bi-megaphone me-1"></i>Thi thử THPT Quốc gia miễn phí</h5>
                <p class="text-muted small mb-3">Các đợt thi thử mở công khai — bất kỳ ai cũng có thể đăng ký tham gia</p>
                <div class="row g-4 mb-5">
                    @foreach (var exam in publicExams)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-exam h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="subject-badge"><i class="bi bi-book me-1"></i>@exam.SubjectName</span>
                                        @Html.Raw(StatusBadge(exam))
                                    </div>
                                    <div class="mb-2">
                                        <span class="badge-status" style="background: rgba(1, 180, 255, .12); color: #0275a8;"><i class="bi @exam.ExamKind.ToIcon() me-1"></i>@exam.ExamKind.ToDisplayName()</span>
                                    </div>
                                    <h5 class="card-title fw-bold mb-2">@exam.Title</h5>
                                    <p class="card-text text-muted small flex-grow-1">@exam.Description</p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li class="mb-1"><i class="bi bi-clock me-2"></i>Thời gian: @exam.Duration phút</li>
                                        <li class="mb-1"><i class="bi bi-calendar-check me-2"></i>Bắt đầu: @(exam.StartTime?.ToString("dd/MM/yyyy HH:mm") ?? "Sớm")</li>
                                        <li class="mb-1"><i class="bi bi-calendar-x me-2"></i>Kết thúc: @(exam.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</li>
                                        <li class="mb-1"><i class="bi bi-list-ol me-2"></i>@exam.QuestionCount câu hỏi</li>
                                        @if (exam.MaxStudents.HasValue)
                                        {
                                            <li class="mb-1"><i class="bi bi-people me-2"></i>Giới hạn: @exam.MaxStudents thí sinh</li>
                                        }
                                    </ul>
                                    <a asp-controller="Exam" asp-action="Detail" asp-route-id="@exam.Id" class="btn btn-primary-custom mt-auto">Đăng ký thi</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (others.Any())
            {
                <h5 class="fw-bold text-uppercase small text-muted mb-3"><i class="bi bi-book me-1"></i>Đề ôn luyện khác</h5>
                <div class="row g-4 mb-5">
                    @foreach (var exam in others)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-exam h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="subject-badge"><i class="bi bi-book me-1"></i>@exam.SubjectName</span>
                                        @Html.Raw(StatusBadge(exam))
                                    </div>
                                    <div class="mb-2">
                                        <span class="badge-status" style="background: rgba(40, 167, 69, .1); color: #1e7e34;"><i class="bi @exam.ExamKind.ToIcon() me-1"></i>@exam.ExamKind.ToDisplayName()</span>
                                    </div>
                                    <h5 class="card-title fw-bold mb-2">@exam.Title</h5>
                                    <p class="card-text text-muted small flex-grow-1">@exam.Description</p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li class="mb-1"><i class="bi bi-clock me-2"></i>Thời gian: @exam.Duration phút</li>
                                        <li class="mb-1"><i class="bi bi-calendar-check me-2"></i>Bắt đầu: @(exam.StartTime?.ToString("dd/MM/yyyy HH:mm") ?? "Sớm")</li>
                                        <li class="mb-1"><i class="bi bi-calendar-x me-2"></i>Kết thúc: @(exam.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</li>
                                        <li class="mb-1"><i class="bi bi-list-ol me-2"></i>@exam.QuestionCount câu hỏi</li>
                                    </ul>
                                    <a asp-controller="Exam" asp-action="Detail" asp-route-id="@exam.Id" class="btn btn-primary-custom mt-auto">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>