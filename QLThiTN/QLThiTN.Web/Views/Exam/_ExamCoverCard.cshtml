@model KhoDeExamItem
@{
    var now = DateTime.Now;
    var isOpen = Model.IsOpen;
    var loaiDe = Model.ExamKind.ToDisplayName();
    var khoaGoi = !Model.LaMienPhi && Context.Session.GetString("LoaiGoi") != "DongPhi";
}
<div class="card exam-cover-card h-100 exam-item" data-loaide="@Model.ExamKind" data-trangthai="@(Model.StartTime > now ? "SapMo" : Model.EndTime < now || !isOpen ? "DaDong" : "DangMo")">
    <partial name="_ExamCover" model="Model" />
    <div class="card-body p-3 d-flex flex-column">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-1 mb-2">
            <span class="small text-muted fw-semibold text-truncate me-1" style="max-width: 130px;" title="@loaiDe">@loaiDe</span>
            <div class="d-flex align-items-center gap-1 ms-auto flex-shrink-0">
                @if (Model.LaMienPhi)
                {
                    <span class="badge-status badge-status-success text-nowrap"><i class="bi bi-unlock me-1"></i>Miễn phí</span>
                }
                else
                {
                    <span class="badge-status badge-vip text-nowrap"><i class="bi bi-patch-check-fill me-1"></i>VIP</span>
                }
                @if (Model.StartTime > now)
                {
                    <span class="badge-status badge-status-warn text-nowrap"><i class="bi bi-hourglass-split me-1"></i>Sắp mở</span>
                }
                else if (Model.EndTime < now || !isOpen)
                {
                    <span class="badge-status badge-status-muted text-nowrap"><i class="bi bi-stop-circle me-1"></i>Đã đóng</span>
                }
                else
                {
                    <span class="badge-status badge-status-success text-nowrap"><i class="bi bi-play-circle me-1"></i>Đang mở</span>
                }
            </div>
        </div>
        <h6 class="fw-bold mb-2 flex-grow-0 cover-card-title">@Model.Title</h6>
        <div class="cover-card-stats small text-muted mb-3">
            <span><i class="bi bi-people me-1"></i>@Model.SoLuotThi lượt thi</span>
            @if (Model.DiemTrungBinh.HasValue)
            {
                <span class="ms-2"><i class="bi bi-bullseye me-1"></i>TB @Model.DiemTrungBinh.Value.ToString("0.0#")</span>
            }
            @if (Model.SoChoConLai.HasValue)
            {
                <span class="ms-2"><i class="bi bi-person-plus me-1"></i>còn @Model.SoChoConLai.Value chỗ</span>
            }
        </div>
        @if (khoaGoi)
        {
            <a asp-controller="Exam" asp-action="Detail" asp-route-id="@Model.Id" asp-route-dotThiId="@Model.DotThiID" class="btn btn-locked-vip w-100 mt-auto">
                <i class="bi bi-lock-fill me-1"></i>Cần gói đóng phí
            </a>
        }
        else if (Model.HasRegistered && isOpen)
        {
            <a asp-controller="Exam" asp-action="Taking" asp-route-id="@Model.Id" asp-route-dotThiId="@Model.DotThiID" class="btn btn-primary-custom w-100 mt-auto">
                <i class="bi bi-play-fill me-1"></i>Vào thi ngay
            </a>
        }
        else
        {
            <a asp-controller="Exam" asp-action="Detail" asp-route-id="@Model.Id" asp-route-dotThiId="@Model.DotThiID" class="btn btn-outline-primary-custom w-100 mt-auto">
                <i class="bi bi-play-fill me-1"></i>@(isOpen && !Model.HasRegistered && !Model.SoChoConLai.HasValue ? "Làm bài" : "Xem chi tiết")
            </a>
        }
    </div>
</div>
