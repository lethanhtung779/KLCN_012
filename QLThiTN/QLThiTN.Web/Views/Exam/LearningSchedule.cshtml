@model LearningScheduleViewModel
@{
    ViewData["Title"] = "Lịch trình học tập";
    var upcoming = Model.Items.Where(i => !i.IsDone && i.DueTime >= DateTime.Now).OrderBy(i => i.DueTime).ToList();
    var overdue = Model.Items.Where(i => !i.IsDone && i.DueTime < DateTime.Now).OrderBy(i => i.DueTime).ToList();
    var done = Model.Items.Where(i => i.IsDone).OrderByDescending(i => i.DueTime).ToList();
}

<section class="py-5">
    <div class="container">
        <div class="mb-4">
            <h1 class="section-title mb-2"><i class="bi bi-calendar2-week me-2"></i>Lịch trình học tập</h1>
            <p class="section-subtitle mb-0">Các bài tập, bài kiểm tra 15 phút và kỳ thi được trung tâm phân công cho bạn</p>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size: 4rem; color: #c3cbe0;"></i>
                <h5 class="mt-3 fw-bold text-muted">Chưa có nhiệm vụ nào được phân công</h5>
            </div>
        }
        else
        {
            @if (overdue.Any())
            {
                <h5 class="fw-bold text-uppercase small mb-3" style="color: var(--danger);"><i class="bi bi-exclamation-triangle me-1"></i>Quá hạn</h5>
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden mb-4" style="border-left: 4px solid var(--danger) !important;">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in overdue)
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                <span class="badge-status bg-danger text-white">Quá hạn</span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@item.Title</div>
                                    <small class="text-muted"><i class="bi bi-book me-1"></i>@item.SubjectName • @item.Type • Hạn: @(item.DueTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</small>
                                </div>
                                @if (item.ExamId.HasValue)
                                {
                                    <a asp-controller="Exam" asp-action="Detail" asp-route-id="@item.ExamId" class="btn btn-sm btn-outline-primary rounded-pill">Làm ngay</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (upcoming.Any())
            {
                <h5 class="fw-bold text-uppercase small mb-3" style="color: var(--accent);"><i class="bi bi-hourglass-split me-1"></i>Sắp đến hạn</h5>
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden mb-4" style="border-left: 4px solid var(--accent) !important;">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in upcoming)
                        {
                            var isSoon = item.DueTime.HasValue && item.DueTime.Value.Subtract(DateTime.Now).TotalHours <= 24;
                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                <span class="stat-icon" style="background: var(--gradient); width: 44px; height: 44px; font-size: 1.1rem;"><i class="bi @(item.Type.Contains("15 phút") ? "bi-stopwatch" : item.Type.Contains("Thi thử") ? "bi-trophy" : "bi-journal-text")"></i></span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@item.Title</div>
                                    <small class="text-muted"><i class="bi bi-book me-1"></i>@item.SubjectName • @item.Type • Hạn: @(item.DueTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</small>
                                </div>
                                @if (isSoon)
                                {
                                    <span class="badge-status" style="background: rgba(255, 159, 67, .15); color: #b36200;">Sắp tới</span>
                                }
                                @if (item.ExamId.HasValue)
                                {
                                    <a asp-controller="Exam" asp-action="Detail" asp-route-id="@item.ExamId" class="btn btn-sm btn-primary-custom">Làm bài</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (done.Any())
            {
                <h5 class="fw-bold text-uppercase small text-muted mb-3"><i class="bi bi-check2-circle me-1"></i>Đã hoàn thành</h5>
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in done)
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@item.Title</div>
                                    <small class="text-muted"><i class="bi bi-book me-1"></i>@item.SubjectName • @item.Type • Hoàn thành: @(item.DueTime?.ToString("dd/MM/yyyy") ?? "—")</small>
                                </div>
                                @if (item.ExamId.HasValue)
                                {
                                    <a asp-controller="Exam" asp-action="Result" asp-route-id="@item.ExamId" class="btn btn-sm btn-outline-secondary rounded-pill">Xem kết quả</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</section>