@model ExamResultViewModel
@{
    ViewData["Title"] = "Kết quả: " + Model.ExamTitle;
    var percentage = Model.TotalQuestions > 0
        ? (int)Math.Round((decimal)Model.CorrectAnswers / Model.TotalQuestions * 100)
        : 0;
}

<!-- Result hero -->
<section class="result-hero">
    <div class="container text-center position-relative">
        <div class="mb-3">
            <span class="badge-gradient"><i class="bi bi-award me-1"></i>Kết quả bài thi</span>
        </div>
        <h2 class="fw-bold mb-3">@Model.ExamTitle</h2>

        @if (Model.ScorePublished)
        {
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-4 mt-4">
                <div class="score-circle">
                    <span class="text-white-50 small">Điểm số</span>
                    <span class="score-val">@Model.Score.ToString("0.00")</span>
                    <span class="text-white-50 small">/ 10.00</span>
                </div>
                <div class="d-flex flex-column gap-3 align-items-start">
                    <span class="score-badge bg-success bg-opacity-25 text-white"><i class="bi bi-check-circle-fill me-2"></i>Trả lời đúng: @Model.CorrectAnswers câu</span>
                    <span class="score-badge bg-danger bg-opacity-25 text-white"><i class="bi bi-x-circle-fill me-2"></i>Trả lời sai: @Model.WrongAnswers câu</span>
                </div>
            </div>

            <div class="row justify-content-center mt-4">
                <div class="col-lg-6">
                    <div class="progress" style="height: 18px; border-radius: 30px; background: rgba(255,255,255,.15);">
                        <div class="progress-bar" role="progressbar"
                             style="width: @percentage%; background: var(--gradient); border-radius: 30px;"
                             aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">@percentage%</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-center mt-4">
                <div class="d-flex flex-column gap-3 align-items-center">
                    <span class="score-badge bg-warning bg-opacity-25 text-white" style="font-size: 1.05rem;">
                        <i class="bi bi-hourglass-split me-2"></i>Bài thi đã được nộp thành công
                    </span>
                    <span class="text-white-50">Điểm số của bạn sẽ được trung tâm công bố sau khi đợt thi kết thúc.</span>
                </div>
            </div>
        }
    </div>
</section>

<!-- Summary -->
<section class="py-4">
    <div class="container">
        <div class="row g-4 @(Model.ScorePublished ? "" : "justify-content-center")">
            @if (Model.ScorePublished)
            {
                <div class="col-md-3">
                    <div class="card stat-card text-center">
                        <div class="card-body">
                            <span class="stat-icon mb-2 mx-auto" style="background: var(--success);"><i class="bi bi-check2-circle"></i></span>
                            <h3 class="mt-2">@Model.CorrectAnswers</h3>
                            <div class="stat-label">Đúng</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card text-center">
                        <div class="card-body">
                            <span class="stat-icon mb-2 mx-auto" style="background: var(--danger);"><i class="bi bi-x-circle"></i></span>
                            <h3 class="mt-2">@Model.WrongAnswers</h3>
                            <div class="stat-label">Sai</div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-3">
                <div class="card stat-card text-center">
                    <div class="card-body">
                        <span class="stat-icon mb-2 mx-auto" style="background: var(--primary);"><i class="bi bi-hourglass-bottom"></i></span>
                        <h3 class="mt-2">@Model.DurationUsed phút</h3>
                        <div class="stat-label">Thời gian làm bài</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card text-center">
                    <div class="card-body">
                        <span class="stat-icon mb-2 mx-auto" style="background: var(--accent2);"><i class="bi bi-calendar-check"></i></span>
                        <h3 class="mt-2">@Model.StartTime.ToString("dd/MM/yyyy")</h3>
                        <div class="stat-label">Ngày thi</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Review answers -->
<section class="py-4">
    <div class="container">
        @if (!Model.ScorePublished)
        {
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-5 text-center text-muted">
                    <i class="bi bi-eye-slash fs-1 d-block mb-3" style="color: var(--accent); opacity: .5;"></i>
                    <h5 class="fw-bold">Kết quả chi tiết chưa được công bố</h5>
                    <p class="mb-0">Trung tâm chưa cho phép hiển thị điểm và đáp án của đợt thi này.<br />
                    Vui lòng quay lại sau khi đợt thi kết thúc.</p>
                </div>
            </div>
        }
        else
        {
        <h5 class="fw-bold mb-4"><i class="bi bi-clipboard-check me-2"></i>Chi tiết bài làm</h5>

        @foreach (var q in Model.QuestionResults)
        {
            var coDiemRieng = q.DiemToiDa > 0;
            <div class="card border-0 rounded-4 shadow-sm mb-3 @(q.IsCorrect ? "result-correct" : "result-wrong")">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3 mb-3 flex-wrap">
                        <span class="badge-status @(q.IsCorrect ? "bg-success text-white" : "bg-danger text-white")">
                            <i class="bi @(q.IsCorrect ? "bi-check-lg" : "bi-x-lg") me-1"></i>
                            @(q.IsCorrect ? "Đúng" : "Sai")
                        </span>
                        @if (coDiemRieng && !q.IsCorrect && q.DiemDat > 0)
                        {
                            <span class="badge-status bg-warning text-dark">@q.DiemDat.ToString("0.##")/@q.DiemToiDa.ToString("0.##") điểm</span>
                        }
                        <div class="fw-medium">Câu @(q.OrderIndex): @Html.Raw(q.Content)</div>
                    </div>
                    <partial name="_QuestionImages" model="@q.Images" />

                    @if (q.Loai == "DungSai" && q.YResults.Count > 0)
                    {
                        @foreach (var y in q.YResults)
                        {
                            <div class="d-flex align-items-start gap-2 py-2 border-bottom">
                                <span class="option-label">@y.Label</span>
                                <span class="flex-grow-1">@Html.Raw(y.Content)</span>
                                <partial name="_QuestionImages" model="@y.Images" />
                                <span class="text-nowrap">
                                    @if (y.ClientLaDung.HasValue)
                                    {
                                        <span class="badge @(y.IsCorrect ? "bg-success" : "bg-danger")">
                                            Bạn: @(y.ClientLaDung.Value ? "Đúng" : "Sai")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Bỏ trống</span>
                                    }
                                    <span class="badge bg-info text-dark">Đáp án: @(y.DapAnDung ? "Đúng" : "Sai")</span>
                                </span>
                            </div>
                        }
                    }
                    else if (q.Loai == "TraLoiNgan")
                    {
                        <div class="py-2">
                            <div class="mb-1">
                                <span class="text-muted">Bạn trả lời: </span>
                                <span class="fw-bold @(q.IsCorrect ? "text-success" : "text-danger")">
                                    @(string.IsNullOrWhiteSpace(q.NoiDungTraLoi) ? "(bỏ trống)" : q.NoiDungTraLoi)
                                </span>
                            </div>
                            <div>
                                <span class="text-muted">Đáp án đúng: </span>
                                <span class="fw-bold text-success">@q.DapAnTraLoiNgan</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 ps-4">
                            @foreach (var opt in q.Options)
                            {
                                var isCorrect = opt.IsCorrect;
                                var isSelected = opt.IsSelected;
                                string cls = "option-item";
                                string icon = "";
                                if (isCorrect) { cls += " border-success"; icon = "bi bi-check-circle-fill text-success ms-auto"; }
                                else if (isSelected) { cls += " border-danger"; icon = "bi bi-x-circle-fill text-danger ms-auto"; }

                                <div class="col-md-6">
                                    <div class="@cls mb-0" style="pointer-events: none; @(cls.Contains("border-success") || cls.Contains("border-danger") ? "" : "opacity: .8;")">
                                        <span class="option-label">@opt.Label</span>
                                        <span class="flex-grow-1">@Html.Raw(opt.Content)</span>
                                        <partial name="_QuestionImages" model="@opt.Images" />
                                        <i class="@icon"></i>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="text-center mt-4">
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a asp-controller="Exam" asp-action="Schedule" class="btn btn-primary-custom btn-lg"><i class="bi bi-calendar-event me-2"></i>Xem các kỳ thi khác</a>
                <a asp-controller="Exam" asp-action="History" class="btn btn-outline-secondary btn-lg"><i class="bi bi-clock-history me-2"></i>Lịch sử thi</a>
            </div>
        </div>
        }
    </div>
</section>