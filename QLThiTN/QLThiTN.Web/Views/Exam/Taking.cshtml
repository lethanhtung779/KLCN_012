@model TakingExamViewModel
@{
    ViewData["Title"] = "Làm bài thi: " + Model.ExamTitle;
    Layout = "_Layout";
    var totalQuestions = Model.Questions.Count;

    // Dap an da luu tren server (phuc hoi bai lam) — tra cuoc theo CauHoiID
    var savedByQuestion = Model.SavedAnswers.ToDictionary(a => a.CauHoiID);
    string? SavedText(int qid) => savedByQuestion.TryGetValue(qid, out var a) ? a.NoiDungTraLoi : null;
    int? SavedOption(int qid) => savedByQuestion.TryGetValue(qid, out var a) ? a.DapAnID : null;
    bool? SavedY(int qid, int dapAnId) => savedByQuestion.TryGetValue(qid, out var a)
        ? a.YChoices.Where(y => y.DapAnID == dapAnId).Select(y => y.LaDung).FirstOrDefault() : null;
}

<!-- Exam header -->
<!-- Exam header (Sticky & Focused) -->
<header class="exam-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Exam" asp-action="Schedule" class="btn btn-sm btn-outline-light rounded-pill px-3" title="Thoát phòng thi">
                    <i class="bi bi-box-arrow-left me-1"></i>Thoát
                </a>
                <div>
                    <div class="fw-bold fs-6 d-flex align-items-center gap-2 flex-wrap">
                        <span>@Model.ExamTitle</span>
                        @if (!string.IsNullOrEmpty(Model.TenMaDe))
                        {
                            <span class="badge bg-warning text-dark fw-bold px-2 py-1 rounded-pill" style="font-size: 0.75rem;" title="Mã đề thi chuẩn THPT Quốc gia">
                                <i class="bi bi-shuffle me-1"></i>Mã đề: @Model.TenMaDe
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2 text-white-50 small">
                        <span><i class="bi bi-list-check me-1"></i>@totalQuestions câu hỏi</span>
                        <span>•</span>
                        <span id="headerProgressText">0% hoàn thành</span>
                    </div>
                </div>
            </div>

            <!-- Progress & Controls -->
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-md-flex flex-column align-items-end me-2">
                    <span class="small text-white-50 mb-1">Tiến độ làm bài</span>
                    <div class="exam-progress-bar-wrap">
                        <div class="exam-progress-bar-fill" id="examProgressFill"></div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-light rounded-circle" id="btnToggleZen" title="Chế độ tập trung (Zen Mode)" style="width: 36px; height: 36px;">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                <span class="timer-box" id="timer"><i class="bi bi-alarm me-2"></i>--:--</span>
            </div>
        </div>
    </div>
</header>

@if (Model.IsResume)
{
    <div class="container mt-3">
        <div class="alert alert-info alert-dismissible fade show mb-0 rounded-4 shadow-sm">
            <i class="bi bi-cloud-arrow-down me-2"></i><b>Đã phục hồi bài làm:</b> hệ thống đã khôi phục các đáp án bạn làm dở và thời gian còn lại tính theo máy chủ.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-4 shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<section class="py-4">
    <div class="container">
        <form id="examForm" asp-controller="Exam" asp-action="Submit" method="post">
            <input type="hidden" name="ExamId" value="@Model.ExamId" />
            <input type="hidden" name="BaiLamID" value="@Model.BaiLamID" />
            <input type="hidden" name="HetGio" id="hetGioFlag" value="false" />
            <input type="hidden" name="StartTime" value="@Model.StartTime.ToString("o")" />
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <!-- Questions -->
                <div class="col-lg-8">
                    <div class="d-flex align-items-center justify-content-between mb-3 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Danh sách câu hỏi</h5>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                                Đã làm: <span id="answeredCount">0</span>/@totalQuestions
                            </span>
                        </div>
                        <span class="save-pill-badge" id="autosaveStatus">
                            <i class="bi bi-cloud-check"></i><span>Đã đồng bộ</span>
                        </span>
                    </div>

                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var q = Model.Questions[i];
                        <div class="card question-card mb-4" id="q-@q.Id" data-q-card-id="@q.Id">
                            <div class="question-head">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-primary rounded-pill me-2 px-2 py-1">@(i + 1)</span>
                                    <span class="fw-bold text-dark">Câu @(i + 1)</span>
                                    @if (q.Loai != "TracNghiem")
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border ms-2">@q.TypeName</span>
                                    }
                                </div>
                                <button type="button" class="btn-flag-q" data-flag-target="@q.Id" title="Ghim để xem lại câu này">
                                    <i class="bi bi-bookmark"></i>
                                    <span>Xem lại</span>
                                </button>
                            </div>
                            <div class="card-body p-4">
                                <div class="fw-medium mb-4 fs-6 text-dark" style="line-height: 1.7;">@Html.Raw(q.Content)</div>
                                <partial name="_QuestionImages" model="@q.Images" />

                                @if (q.Loai == "TraLoiNgan")
                                {
                                    <div data-question-id="@q.Id" data-question-type="TraLoiNgan">
                                        <label class="form-label fw-semibold text-secondary small text-uppercase">Đáp số / Kết quả:</label>
                                        <input type="text" class="form-control form-control-lg tln-input rounded-3" style="max-width: 360px;"
                                               name="Answers[@i].NoiDungTraLoi" value="@SavedText(q.Id)" placeholder="Nhập câu trả lời..."
                                               autocomplete="off" />
                                        <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                                    </div>
                                }
                                else if (q.Loai == "DungSai")
                                {
                                    <div data-question-id="@q.Id" data-question-type="DungSai">
                                        <div class="small fw-semibold text-muted mb-3"><i class="bi bi-info-circle me-1"></i>Chọn <b>Đúng</b> hoặc <b>Sai</b> cho từng mệnh đề sau:</div>
                                        @for (int j = 0; j < q.Options.Count; j++)
                                        {
                                            var opt = q.Options[j];
                                            var yChon = SavedY(q.Id, opt.Id);
                                            <div class="d-flex align-items-start gap-3 p-3 mb-2 rounded-3 border bg-light bg-opacity-50 ds-y-row">
                                                <div class="flex-grow-1">
                                                    <span class="badge bg-light text-dark border me-2">@opt.Label</span>
                                                    <span>@Html.Raw(opt.Content)</span>
                                                    <partial name="_QuestionImages" model="@opt.Images" />
                                                </div>
                                                <div class="d-flex gap-2 flex-shrink-0 pt-1">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <input type="radio" class="btn-check" name="Answers[@i].YChoices[@j].LaDung" id="ds-d-@opt.Id" value="true" checked="@(yChon == true)" autocomplete="off">
                                                        <label class="btn btn-outline-success px-3" for="ds-d-@opt.Id">Đúng</label>

                                                        <input type="radio" class="btn-check" name="Answers[@i].YChoices[@j].LaDung" id="ds-s-@opt.Id" value="false" checked="@(yChon == false)" autocomplete="off">
                                                        <label class="btn btn-outline-danger px-3" for="ds-s-@opt.Id">Sai</label>
                                                    </div>
                                                </div>
                                                <input type="hidden" name="Answers[@i].YChoices[@j].DapAnID" value="@opt.Id" />
                                            </div>
                                        }
                                        <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                                    </div>
                                }
                                else
                                {
                                    var chon = SavedOption(q.Id);
                                    <div class="row g-3" data-question-id="@q.Id" data-question-type="TracNghiem">
                                        @foreach (var opt in q.Options)
                                        {
                                            var isSelected = chon == opt.Id;
                                            <div class="col-md-6">
                                                <label class="option-item w-100 mb-0 @(isSelected ? "selected" : "")" data-option-id="@opt.Id">
                                                    <input type="radio" class="d-none" name="Answers[@i].SelectedOptionId" value="@opt.Id" checked="@isSelected" />
                                                    <span class="option-label">@opt.Label</span>
                                                    <span class="flex-grow-1">@Html.Raw(opt.Content)</span>
                                                    <partial name="_QuestionImages" model="@opt.Images" />
                                                </label>
                                            </div>
                                        }
                                        <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-3 my-4">
                        <button type="submit" class="btn btn-primary-custom btn-lg px-4" id="btnSubmit">
                            <i class="bi bi-check2-circle me-2"></i>Nộp bài thi
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-lg px-4" id="btnReset">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Làm lại từ đầu
                        </button>
                    </div>
                </div>

                <!-- Sticky Palette -->
                <div class="col-lg-4">
                    <div class="answer-palette p-4 sticky-top" style="top: 85px;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-3x3 me-2 text-primary"></i>Bảng câu hỏi</h6>
                            <span class="badge bg-light text-muted border" id="flagCountBadge"><i class="bi bi-bookmark-fill text-warning me-1"></i><span id="flaggedCount">0</span> đã ghim</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-4" id="paletteGrid">
                            @for (int i = 0; i < totalQuestions; i++)
                            {
                                var q = Model.Questions[i];
                                <a href="#q-@q.Id" class="num-btn" data-nav-target="@q.Id">@(i + 1)</a>
                            }
                        </div>
                        <div class="p-3 bg-light rounded-3 mb-3 small">
                            <div class="row g-2">
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <span class="num-btn answered" style="width: 22px; height: 22px; pointer-events: none; font-size: 0.65rem;"></span>
                                    <span>Đã làm</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <span class="num-btn" style="width: 22px; height: 22px; pointer-events: none; font-size: 0.65rem;"></span>
                                    <span>Chưa làm</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <span class="num-btn flagged" style="width: 22px; height: 22px; pointer-events: none; font-size: 0.65rem;"></span>
                                    <span>Cần xem lại</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <span class="num-btn active-q" style="width: 22px; height: 22px; pointer-events: none; font-size: 0.65rem;"></span>
                                    <span>Đang xem</span>
                                </div>
                            </div>
                        </div>
                        <hr class="my-3">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill shadow-sm">
                                <i class="bi bi-send-check me-2"></i>Nộp bài thi ngay
                            </button>
                            <small class="text-muted text-center mt-1"><i class="bi bi-alarm me-1"></i>Hệ thống sẽ tự động thu bài khi hết giờ</small>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/exam-autosave.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var remainingSeconds = @Model.RemainingSeconds;
            var examId = @Model.ExamId;
            var baiLamId = @Model.BaiLamID;
            var antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();
            var submitting = false;

            // Đồng hồ đếm ngược theo mốc server (F5 không được cộng thêm thời gian)
            var deadline = new Date().getTime() + remainingSeconds * 1000;
            var timerInterval = window.setInterval(tickTimer, 1000);
            tickTimer();

            function tickTimer() {
                var remaining = Math.max(0, Math.round((deadline - new Date().getTime()) / 1000));
                var display = $('.timer-box').first();
                if (display.length === 0) return;

                var h = Math.floor(remaining / 3600);
                var m = Math.floor((remaining % 3600) / 60);
                var s = remaining % 60;
                var text = '';
                if (h > 0) text += (h < 10 ? '0' : '') + h + ':';
                text += (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
                display.text(text);

                if (remaining <= 300) display.addClass('critical');

                if (remaining <= 0) {
                    window.clearInterval(timerInterval);
                    if (!submitting) {
                        $('#hetGioFlag').val('true');
                        submitting = true;
                        $('#examForm').submit();
                    }
                }
            }

            // Bai phuc hoi ma thoi gian da het -> nop ngay
            if (remainingSeconds <= 0 && !submitting) {
                $('#hetGioFlag').val('true');
                submitting = true;
                $('#examForm').submit();
            }

            // Mot cau duoc tinh la DA TRA LOI khi:
            //  - TracNghiem: da chon 1 phuong an
            //  - DungSai: ca cac y a-d deu co lua chon Dung/Sai
            //  - TraLoiNgan: o nhap khong rong
            function daTraLoi($group) {
                var loai = $group.attr('data-question-type');
                if (loai === 'DungSai') {
                    var rows = $group.find('.ds-y-row');
                    if (rows.length === 0) return false;
                    return rows.toArray().every(function (row) {
                        return $(row).find('input[type="radio"]:checked').length > 0;
                    });
                }
                if (loai === 'TraLoiNgan') {
                    return $group.find('.tln-input').val().trim().length > 0;
                }
                return $group.find('input[type="radio"]:checked').length > 0;
            }

            function demDaTraLoi() {
                var answered = 0;
                $('[data-question-id]').each(function () {
                    if (daTraLoi($(this))) answered++;
                });
                return answered;
            }

            function updatePalette() {
                var answered = 0;
                var total = $('[data-question-id]').length;
                $('[data-question-id]').each(function () {
                    var $group = $(this);
                    var qId = $group.attr('data-question-id');
                    var $nav = $('.num-btn[data-nav-target="' + qId + '"]');
                    var isAns = daTraLoi($group);
                    $nav.toggleClass('answered', isAns);
                    if (isAns) answered++;
                });

                $('#answeredCount').text(answered);
                var pct = total > 0 ? Math.round((answered / total) * 100) : 0;
                $('#examProgressFill').css('width', pct + '%');
                $('#headerProgressText').text(pct + '% hoàn thành');
            }

            // Flag/Bookmark câu hỏi để xem lại
            var flaggedMap = {};
            $('.btn-flag-q').on('click', function (e) {
                e.preventDefault();
                var $btn = $(this);
                var qId = $btn.attr('data-flag-target');
                var $card = $('#q-' + qId);
                var $nav = $('.num-btn[data-nav-target="' + qId + '"]');

                if (flaggedMap[qId]) {
                    delete flaggedMap[qId];
                    $btn.removeClass('active');
                    $btn.find('i').removeClass('bi-bookmark-fill text-warning').addClass('bi-bookmark');
                    $card.removeClass('flagged');
                    $nav.removeClass('flagged');
                } else {
                    flaggedMap[qId] = true;
                    $btn.addClass('active');
                    $btn.find('i').removeClass('bi-bookmark').addClass('bi-bookmark-fill text-warning');
                    $card.addClass('flagged');
                    $nav.addClass('flagged');
                }
                var count = Object.keys(flaggedMap).length;
                $('#flaggedCount').text(count);
            });

            // Highlight câu hỏi đang làm khi cuộn tới hoặc click trên palette
            $('.num-btn[data-nav-target]').on('click', function () {
                $('.num-btn').removeClass('active-q');
                $(this).addClass('active-q');
            });

            // Zen mode (Chế độ tập trung tối đa)
            var zenMode = false;
            $('#btnToggleZen').on('click', function () {
                zenMode = !zenMode;
                $('body').toggleClass('zen-mode', zenMode);
                $(this).toggleClass('btn-light text-primary', zenMode);
                var icon = zenMode ? 'bi-fullscreen-exit' : 'bi-arrows-fullscreen';
                $(this).find('i').attr('class', 'bi ' + icon);
            });

            // Xu ly chon dap an trac nghiem
            $('.option-item').on('click', function () {
                var $option = $(this);
                var $group = $option.closest('[data-question-id]');
                $group.find('.option-item').removeClass('selected');
                $option.addClass('selected');
                $option.find('input[type="radio"]').prop('checked', true);
                updatePalette();
                markDirty();
            });

            // Cau Dung/Sai
            $('.ds-y-row input[type="radio"]').on('change', function () {
                updatePalette();
                markDirty();
            });

            // Cau tra loi ngan
            $('.tln-input').on('input', function () {
                updatePalette();
                markDirty();
            });

            updatePalette();

            // ------------------------------------------------------------------
            // Tu dong luu tien trinh ve server (de cuong: phong su co)
            // ------------------------------------------------------------------
            var saveTimerId = null;
            var debounceSaveId = null;
            var autosave = new ExamAutosave(function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '@Url.Action("LuuTam", "Exam")',
                        type: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json',
                        timeout: 10000,
                        headers: { 'RequestVerificationToken': antiForgeryToken },
                        data: JSON.stringify({ ExamId: examId, BaiLamID: baiLamId, Answers: collectAnswers() }),
                        success: resolve,
                        error: function () { reject(new Error('Chưa đồng bộ được. Hãy giữ trang mở; hệ thống sẽ thử lại.')); }
                    });
                });
            }, function (state, detail) {
                var text = state === 'saved' ? 'Đã lưu ' + (detail || '')
                    : state === 'saving' ? 'Đang lưu...'
                    : state === 'pending' ? 'Có thay đổi chưa lưu'
                    : detail || 'Mất kết nối — còn thay đổi chưa lưu';
                $('#autosaveStatus').text(text).toggleClass('text-danger', state === 'error');
            });

            function markDirty() {
                autosave.markDirty();
                window.clearTimeout(debounceSaveId);
                debounceSaveId = window.setTimeout(luuTam, 800);
            }

            function collectAnswers() {
                var answers = [];
                $('[data-question-id]').each(function () {
                    var $group = $(this);
                    var qId = parseInt($group.attr('data-question-id'), 10);
                    var loai = $group.attr('data-question-type');
                    var answer = { QuestionId: qId, SelectedOptionId: null, NoiDungTraLoi: null, YChoices: [] };
                    if (loai === 'TraLoiNgan') {
                        var text = $group.find('.tln-input').val();
                        if (text && text.trim().length > 0) answer.NoiDungTraLoi = text;
                    } else if (loai === 'DungSai') {
                        $group.find('.ds-y-row').each(function () {
                            var dapAnId = parseInt($(this).find('input[name$=".DapAnID"]').val(), 10);
                            var chon = $(this).find('input[type="radio"]:checked');
                            if (dapAnId > 0 && chon.length > 0) {
                                answer.YChoices.push({ DapAnID: dapAnId, LaDung: chon.val() === 'true' });
                            }
                        });
                    } else {
                        var selected = parseInt($group.find('input[type="radio"]:checked').val(), 10);
                        if (selected > 0) answer.SelectedOptionId = selected;
                    }
                    answers.push(answer);
                });
                return answers;
            }

            function luuTam() {
                if (!submitting) return autosave.flush();
            }

            window.addEventListener('online', luuTam);
            window.addEventListener('beforeunload', function (event) {
                if (!submitting && autosave.dirty) {
                    event.preventDefault();
                    event.returnValue = '';
                }
            });

            saveTimerId = window.setInterval(function () { luuTam(); }, 15000);

            // Luu ngay khi roi trang (chuyen tab, thu nho cua so)
            document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'hidden') luuTam();
            });

            // Xoa tat ca dap an
            $('#btnReset').on('click', function () {
                if (confirm('Bạn có chắc chắn muốn xóa tất cả câu trả lời?')) {
                    $('.option-item').removeClass('selected');
                    $('input[type="radio"]').prop('checked', false);
                    $('.tln-input').val('');
                    markDirty();
                    updatePalette();
                }
            });

            // Xac nhận trước khi nộp bài
            $('#examForm').on('submit', function () {
                if (submitting) return true;
                var answered = demDaTraLoi();
                var total = $('[data-question-id]').length;
                var msg = answered === total
                    ? 'Bạn đã trả lời tất cả ' + total + ' câu hỏi. Xác nhận nộp bài?'
                    : 'Bạn chỉ mới trả lời ' + answered + '/' + total + ' câu. Vẫn nộp bài?';
                if ($('#hetGioFlag').val() !== 'true') {
                    if (!confirm(msg)) return false;
                }
                submitting = true;
                window.clearTimeout(debounceSaveId);
                window.clearInterval(saveTimerId);
                $('#btnSubmit, #btnReset').prop('disabled', true);
                return true;
            });
        });
    </script>
}
