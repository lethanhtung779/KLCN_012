@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var userFullName = Context.Session.GetString("UserFullName");
    var isLoggedIn = !string.IsNullOrEmpty(userFullName);
    var isCenterStudent = Context.Session.GetString("LaHocVienTrungTam") == "1";
    var isVip = Context.Session.GetString("LaVip") == "1" || Context.Session.GetString("LoaiGoi") == "DongPhi";
}

<!-- Hero -->
<section class="hero">
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-8 col-xl-7">
                @if (isLoggedIn)
                {
                    if (isCenterStudent)
                    {
                        <span class="badge-gradient mb-3"><i class="bi bi-building-check me-1"></i> Xin chào, @userFullName (Học viên trung tâm)</span>
                    }
                    else if (isVip)
                    {
                        <span class="badge-gradient mb-3"><i class="bi bi-patch-check-fill me-1"></i> Xin chào, @userFullName (Học viên VIP)</span>
                    }
                    else
                    {
                        <span class="badge-gradient mb-3"><i class="bi bi-person-check-fill me-1"></i> Xin chào, @userFullName</span>
                    }
                }
                else
                {
                    <span class="badge-gradient mb-3"><i class="bi bi-megaphone me-1"></i> Thi thử THPT Quốc gia miễn phí — mở đăng ký</span>
                }
                <h1 class="hero-title mb-3">Kiểm tra — đánh giá <span class="text-nowrap">chuẩn khoa học</span></h1>

                @* Social-proof tu so lieu that cua he thong *@
                <div class="hero-social-pill mb-4">
                    <span class="avatar-stack">
                        <span class="mini-avatar"><i class="bi bi-person-fill"></i></span>
                        <span class="mini-avatar"><i class="bi bi-person-fill"></i></span>
                        <span class="mini-avatar"><i class="bi bi-person-fill"></i></span>
                    </span>
                    <span><b>@Model.TongCauHoi.ToString("N0")</b> câu hỏi trong ngân hàng • <b>@Model.TongLuotLamBai.ToString("N0")</b> lượt làm bài</span>
                </div>

                <p class="hero-lead mb-4">Hệ thống thi trắc nghiệm trực tuyến của trung tâm luyện thi: làm bài tính giờ, tự động lưu tiến trình, chấm điểm tức thì và phân tích kết quả chi tiết cho từng học viên.</p>
                @if (isLoggedIn)
                {
                    <div class="d-flex gap-3 flex-wrap">
                        @if (isCenterStudent)
                        {
                            <a asp-controller="Exam" asp-action="LearningSchedule" class="btn btn-primary-custom btn-lg"><i class="bi bi-calendar2-week me-2"></i>Lịch trình học tập</a>
                            <a asp-controller="Exam" asp-action="KhoDe" class="btn btn-outline-custom btn-lg"><i class="bi bi-collection me-2"></i>Khám phá kho đề</a>
                        }
                        else
                        {
                            <a asp-controller="Exam" asp-action="KhoDe" class="btn btn-primary-custom btn-lg"><i class="bi bi-collection me-2"></i>Khám phá kho đề</a>
                            <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-custom btn-lg"><i class="bi bi-calendar-check me-2"></i>Xem lịch thi thử</a>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Exam" asp-action="Schedule" class="btn btn-primary-custom btn-lg"><i class="bi bi-calendar-check me-2"></i>Xem lịch thi</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom btn-lg"><i class="bi bi-person-plus me-2"></i>Đăng ký thi thử miễn phí</a>
                    </div>
                }
                <div class="d-flex gap-4 mt-4 pt-2">
                    <div>
                        <h4 class="fw-bold mb-0 text-white">@Model.TotalExams</h4>
                        <small class="hero-stat-label">Kỳ thi / đề luyện</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">@Model.UpcomingExams</h4>
                        <small class="hero-stat-label">Đợt thi đang mở</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">@Model.CompletedExams</h4>
                        <small class="hero-stat-label">Bài đã hoàn thành</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-xl-5 d-none d-lg-block text-center text-xl-end">
                <svg class="hero-art" viewBox="0 0 460 400" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Minh họa học sinh làm bài thi trắc nghiệm trực tuyến">
                    <defs>
                        <linearGradient id="hg1" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#01b4ff"/>
                            <stop offset="1" stop-color="#7c4dff"/>
                        </linearGradient>
                        <linearGradient id="hg2" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#ffffff" stop-opacity=".96"/>
                            <stop offset="1" stop-color="#e8efff" stop-opacity=".92"/>
                        </linearGradient>
                    </defs>
                    <!-- vòng tròn nền -->
                    <circle cx="230" cy="200" r="168" fill="#ffffff" fill-opacity=".06"/>
                    <circle cx="230" cy="200" r="122" fill="#ffffff" fill-opacity=".05"/>
                    <!-- cửa sổ trình duyệt -->
                    <rect x="70" y="72" width="320" height="240" rx="18" fill="url(#hg2)"/>
                    <rect x="70" y="72" width="320" height="40" rx="18" fill="#22335e"/>
                    <rect x="70" y="94" width="320" height="18" fill="#22335e"/>
                    <circle cx="96" cy="92" r="5.5" fill="#ff5f57"/>
                    <circle cx="114" cy="92" r="5.5" fill="#febc2e"/>
                    <circle cx="132" cy="92" r="5.5" fill="#28c840"/>
                    <rect x="150" y="86" width="180" height="12" rx="6" fill="#ffffff" fill-opacity=".18"/>
                    <!-- đồng hồ -->
                    <circle cx="118" cy="150" r="21" fill="#01b4ff"/>
                    <path d="M118 139v11l8 6" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    <!-- câu hỏi -->
                    <rect x="152" y="134" width="180" height="10" rx="5" fill="#2b3452" fill-opacity=".85"/>
                    <rect x="152" y="152" width="126" height="10" rx="5" fill="#2b3452" fill-opacity=".35"/>
                    <!-- 4 lựa chọn A-D -->
                    <g>
                        <rect x="94" y="186" width="132" height="26" rx="8" fill="#01b4ff" fill-opacity=".16"/>
                        <circle cx="110" cy="199" r="9" fill="#01b4ff"/>
                        <text x="110" y="203.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">A</text>
                        <rect x="126" y="193" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".45"/>
                        <rect x="238" y="186" width="132" height="26" rx="8" fill="#2b3452" fill-opacity=".08"/>
                        <circle cx="254" cy="199" r="9" fill="#2b3452" fill-opacity=".3"/>
                        <text x="254" y="203.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">B</text>
                        <rect x="270" y="193" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".25"/>
                        <rect x="94" y="220" width="132" height="26" rx="8" fill="#2b3452" fill-opacity=".08"/>
                        <circle cx="110" cy="233" r="9" fill="#2b3452" fill-opacity=".3"/>
                        <text x="110" y="237.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">C</text>
                        <rect x="126" y="227" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".25"/>
                        <rect x="238" y="220" width="132" height="26" rx="8" fill="#2b3452" fill-opacity=".08"/>
                        <circle cx="254" cy="233" r="9" fill="#2b3452" fill-opacity=".3"/>
                        <text x="254" y="237.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">D</text>
                        <rect x="270" y="227" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".25"/>
                    </g>
                    <rect x="94" y="262" width="276" height="30" rx="15" fill="url(#hg1)"/>
                    <text x="232" y="282" text-anchor="middle" font-family="Arial" font-size="13" font-weight="bold" fill="#fff">NỘP BÀI</text>
                    <!-- huy hiệu điểm -->
                    <g>
                        <circle cx="86" cy="316" r="38" fill="#ffffff"/>
                        <circle cx="86" cy="316" r="30" fill="url(#hg1)"/>
                        <text x="86" y="312" text-anchor="middle" font-family="Arial" font-size="17" font-weight="bold" fill="#fff">9.5</text>
                        <text x="86" y="328" text-anchor="middle" font-family="Arial" font-size="9" fill="#ffffff" fill-opacity=".85">điểm</text>
                    </g>
                    <!-- huy hiệu đạt -->
                    <g>
                        <circle cx="374" cy="318" r="30" fill="#ffffff"/>
                        <path d="M374 300l6 12 13 2-9.5 9 2.5 13-12-6.5-12 6.5 2.5-13-9.5-9 13-2z" fill="#28c76f"/>
                    </g>
                    <!-- mũi tên kết nối -->
                    <path d="M70 316 C 40 300, 40 260, 66 246" stroke="#ffffff" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 8" fill="none"/>
                    <path d="M394 290 C 420 270, 420 240, 396 228" stroke="#ffffff" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 8" fill="none"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title mb-2">Mô hình hoạt động</h2>
            <p class="section-subtitle">Học viên vẫn học tại lớp như thường lệ, kỳ thi được tổ chức trực tuyến</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card card-exam h-100 text-center">
                    <div class="card-body">
                        <span class="stat-icon mx-auto mb-3" style="background: var(--primary); width: 64px; height: 64px; font-size: 1.6rem;"><i class="bi bi-easel"></i></span>
                        <h5 class="fw-bold">1. Học Offline</h5>
                        <p class="text-muted small mb-0">Đến lớp theo lịch học buổi tối, nghe giảng và tương tác trực tiếp với giáo viên chuyên môn.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-exam h-100 text-center">
                    <div class="card-body">
                        <span class="stat-icon mx-auto mb-3" style="background: var(--gradient); width: 64px; height: 64px; font-size: 1.6rem;"><i class="bi bi-pencil-square"></i></span>
                        <h5 class="fw-bold">2. Thi Online</h5>
                        <p class="text-muted small mb-0">Kiểm tra 15 phút, bài tập về nhà, thi thử cuối tháng và thi thử THPT đều làm trực tuyến trên Website.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-exam h-100 text-center">
                    <div class="card-body">
                        <span class="stat-icon mx-auto mb-3" style="background: var(--success); width: 64px; height: 64px; font-size: 1.6rem;"><i class="bi bi-graph-up-arrow"></i></span>
                        <h5 class="fw-bold">3. Chấm điểm tự động</h5>
                        <p class="text-muted small mb-0">Hệ thống đếm giờ, thu bài, chấm điểm ngay lập tức; giáo viên theo dõi tiến bộ của từng học viên.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats -->
<section class="py-4 home-stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--gradient);"><i class="bi bi-calendar-event"></i></span>
                        <div>
                            <h3>@Model.TotalExams</h3>
                            <div class="stat-label">Tổng kỳ thi</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--primary);"><i class="bi bi-hourglass-split"></i></span>
                        <div>
                            <h3>@Model.UpcomingExams</h3>
                            <div class="stat-label">Sắp / đang mở</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--success);"><i class="bi bi-check2-circle"></i></span>
                        <div>
                            <h3>@Model.CompletedExams</h3>
                            <div class="stat-label">Đã hoàn thành</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--accent2);"><i class="bi bi-trophy"></i></span>
                        <div>
                            <h3>@Model.AverageScore.ToString("0.0")</h3>
                            <div class="stat-label">Điểm trung bình</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest public exams -->
<section class="py-4">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between mb-4">
            <div>
                <h2 class="section-title mb-1">Thi thử THPT miễn phí</h2>
                @if (isLoggedIn)
                {
                    <p class="section-subtitle mb-0">Các đợt thi thử THPT Quốc gia mở công khai để bạn thử sức và rèn luyện kỹ năng</p>
                }
                else
                {
                    <p class="section-subtitle mb-0">Đăng ký tài khoản để tham gia các đợt thi thử mở công khai, biết ngay năng lực hiện tại</p>
                }
            </div>
            <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-primary btn-sm rounded-pill">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
        </div>

        <div class="row g-4">
            @if (Model.LatestPublicExams.Any())
            {
                @foreach (var exam in Model.LatestPublicExams)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card exam-cover-card h-100">
                            <partial name="_ExamCover" model="exam" />
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="cover-card-stats small text-muted mb-2">
                                    <span><i class="bi bi-people me-1"></i>@exam.SoLuotThi lượt thi</span>
                                    @if (exam.DiemTrungBinh.HasValue)
                                    {
                                        <span class="ms-2"><i class="bi bi-bullseye me-1"></i>TB @exam.DiemTrungBinh.Value.ToString("0.0#")</span>
                                    }
                                    <span class="ms-2"><i class="bi bi-list-ol me-1"></i>@exam.QuestionCount câu</span>
                                </div>
                                <a asp-controller="Exam" asp-action="Detail" asp-route-id="@exam.Id" asp-route-dotThiId="@exam.DotThiID" class="btn btn-sm btn-primary-custom mt-auto">
                                    <i class="bi bi-play-fill me-1"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="card border-0 rounded-4 shadow-sm">
                        <div class="card-body p-5 text-center text-muted">
                            <i class="bi bi-megaphone fs-1 d-block mb-3" style="color: var(--accent2); opacity: .45;"></i>
                            <h5 class="fw-bold">Đợt thi thử công khai sẽ sớm được mở</h5>
                            @if (isLoggedIn)
                            {
                                <p class="mb-3">Hiện chưa có đợt thi thử công khai mới đang diễn ra. Bạn có thể vào <strong>Kho đề</strong> để luyện tập các bộ đề có sẵn hoặc xem <strong>Lịch thi</strong> để chuẩn bị cho các đợt thi sắp tới.</p>
                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                    <a asp-controller="Exam" asp-action="KhoDe" class="btn btn-primary-custom">
                                        <i class="bi bi-collection me-1"></i>Khám phá kho đề
                                    </a>
                                    <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-secondary rounded-pill">
                                        <i class="bi bi-calendar-event me-1"></i>Xem lịch thi
                                    </a>
                                </div>
                            }
                            else
                            {
                                <p class="mb-3">Đăng ký tài khoản để nhận thông báo khi có đợt thi thử THPT Quốc gia miễn phí mới.</p>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom">
                                    <i class="bi bi-person-plus me-1"></i>Đăng ký ngay
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (isLoggedIn)
{
    <!-- Quick Shortcuts for Logged-in Students -->
    <section class="py-5 home-shortcuts-section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="badge-status badge-status-info mb-2">
                    <i class="bi @(isCenterStudent ? "bi-building-check" : "bi-person-workspace") me-1"></i>
                    @(isCenterStudent ? "Khu vực Học viên Trung tâm" : "Không gian Luyện thi Trực tuyến")
                </span>
                <h2 class="section-title mb-2">Thao tác nhanh & Không gian học tập</h2>
                <p class="section-subtitle">
                    @(isCenterStudent
                        ? "Theo dõi lịch học tại lớp, hoàn thành bài tập được giao và tự do ôn luyện đề thi"
                        : "Khám phá kho đề thi chuẩn, kiểm tra năng lực và theo dõi sự tiến bộ của bạn")
                </p>
            </div>

            <div class="row g-4">
                @if (isCenterStudent)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--primary); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-calendar2-week"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Lịch trình học tập</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Theo dõi thời khóa biểu tại lớp, bài tập về nhà và các bài kiểm tra được giáo viên phân công.</p>
                                <a asp-controller="Exam" asp-action="LearningSchedule" class="btn btn-primary-custom btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-calendar-event me-1"></i>Vào lịch học
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--gradient); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-pencil-square"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Lịch thi & Ca thi</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Tham gia các đợt kiểm tra định kỳ, thi thử cuối tháng hoặc đợt thi tập trung của trung tâm.</p>
                                <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-clock-history me-1"></i>Xem ca thi
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--success); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-collection"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Kho đề tự luyện</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Tự do luyện thi không giới hạn với hàng chục bộ đề trắc nghiệm chuẩn cấu trúc mới.</p>
                                <a asp-controller="Exam" asp-action="KhoDe" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-book me-1"></i>Khám phá kho đề
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--accent2); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Lịch sử & Kết quả</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Xem lại điểm số, bảng phân tích kết quả từng câu và theo dõi sự tiến bộ qua thời gian.</p>
                                <a asp-controller="Exam" asp-action="History" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-trophy me-1"></i>Xem bảng điểm
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--primary); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-collection"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Kho đề luyện thi</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Khám phá các bộ đề thi thử tốt nghiệp THPT chuẩn cấu trúc phân chia theo từng môn học.</p>
                                <a asp-controller="Exam" asp-action="KhoDe" class="btn btn-primary-custom btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-play-circle me-1"></i>Luyện đề ngay
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--success); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-megaphone"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Đợt thi thử miễn phí</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Theo dõi và đăng ký tham gia các kỳ thi thử mở công khai để cọ xát và đánh giá năng lực.</p>
                                <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-calendar-check me-1"></i>Xem lịch thi
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <span class="stat-icon mx-auto mb-3" style="background: var(--accent2); width: 60px; height: 60px; font-size: 1.5rem;">
                                    <i class="bi bi-clock-history"></i>
                                </span>
                                <h5 class="fw-bold mb-2">Lịch sử làm bài</h5>
                                <p class="text-muted small mb-4 flex-grow-1">Tra cứu các bài thi đã làm, xem lại đáp án chi tiết và theo dõi điểm trung bình của bạn.</p>
                                <a asp-controller="Exam" asp-action="History" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
                                    <i class="bi bi-award me-1"></i>Xem lịch sử
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card card-exam h-100 border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                @if (isVip)
                                {
                                    <span class="stat-icon mx-auto mb-3" style="background: var(--warning); width: 60px; height: 60px; font-size: 1.5rem;">
                                        <i class="bi bi-patch-check-fill text-white"></i>
                                    </span>
                                    <h5 class="fw-bold mb-2">Gói VIP hiệu lực</h5>
                                    <p class="text-muted small mb-4 flex-grow-1">Tài khoản của bạn đã được kích hoạt VIP. Tự do mở khóa mọi bộ đề nâng cao không giới hạn.</p>
                                    <a asp-controller="Exam" asp-action="KhoDe" class="btn btn-outline-success btn-sm rounded-pill mt-auto">
                                        <i class="bi bi-unlock-fill me-1"></i>Kho đề VIP
                                    </a>
                                }
                                else
                                {
                                    <span class="stat-icon mx-auto mb-3" style="background: var(--gradient); width: 60px; height: 60px; font-size: 1.5rem;">
                                        <i class="bi bi-gem"></i>
                                    </span>
                                    <h5 class="fw-bold mb-2">Nâng cấp VIP</h5>
                                    <p class="text-muted small mb-4 flex-grow-1">Mở khóa toàn bộ ngân hàng đề thi VIP, xem lời giải chi tiết và tăng tốc độ ôn luyện.</p>
                                    <a asp-controller="Vip" asp-action="Index" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark mt-auto">
                                        <i class="bi bi-lightning-charge-fill me-1"></i>Nâng cấp ngay
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
else
{
    <!-- Features for Unauthenticated Guests -->
    <section class="py-5 home-features-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title mb-2">Trải nghiệm thi trực tuyến chuyên nghiệp</h2>
                <p class="section-subtitle">Nền tảng luyện thi và đánh giá năng lực trắc nghiệm trực tuyến chuẩn cấu trúc tốt nghiệp THPT</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon" style="background: var(--gradient);"><i class="bi bi-alarm"></i></span>
                        <div>
                            <h6 class="fw-bold">Đồng hồ đếm ngược</h6>
                            <p class="text-muted small mb-0">Làm bài tính giờ như phòng thi thật, rèn luyện kỹ năng phân bổ thời gian dưới áp lực.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon" style="background: var(--success);"><i class="bi bi-cloud-arrow-up"></i></span>
                        <div>
                            <h6 class="fw-bold">Tự động lưu tiến trình</h6>
                            <p class="text-muted small mb-0">Bài làm được lưu liên tục trên máy chủ, an toàn khi gặp sự cố mạng, quay lại là làm tiếp được ngay.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon" style="background: var(--accent2);"><i class="bi bi-check2-circle"></i></span>
                        <div>
                            <h6 class="fw-bold">Chấm điểm tức thì</h6>
                            <p class="text-muted small mb-0">Hệ thống tự động thu bài khi hết giờ, chấm điểm và hiển thị kết quả nếu trung tâm công bố điểm sớm.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon" style="background: var(--primary);"><i class="bi bi-search"></i></span>
                        <div>
                            <h6 class="fw-bold">Xem đáp án & Phân tích chi tiết</h6>
                            <p class="text-muted small mb-0">Đối chiếu bài làm, xem lại các câu đúng/sai để nhận biết lỗ hổng kiến thức và rút kinh nghiệm.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon" style="background: var(--warning);"><i class="bi bi-journal-bookmark-fill"></i></span>
                        <div>
                            <h6 class="fw-bold">Ngân hàng đề thi chuẩn 2025</h6>
                            <p class="text-muted small mb-0">Đầy đủ các môn học với đa dạng dạng câu hỏi: Trắc nghiệm 4 lựa chọn, Đúng/Sai và Trả lời ngắn.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon" style="background: var(--pink);"><i class="bi bi-phone"></i></span>
                        <div>
                            <h6 class="fw-bold">Hỗ trợ mọi thiết bị</h6>
                            <p class="text-muted small mb-0">Làm bài trên máy tính, tablet hay điện thoại — mở trình duyệt là làm bài trực tuyến được ngay.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- CTA -->
<section class="py-5">
    <div class="container">
        <div class="card border-0 rounded-4" style="background: var(--gradient-dark);">
            <div class="card-body p-5 text-center">
                @if (isLoggedIn)
                {
                    <h2 class="text-white fw-bold mb-2">Sẵn sàng chinh phục kỳ thi hôm nay?</h2>
                    <p class="text-white-50 mb-4">Bạn đang đăng nhập với tài khoản <b>@userFullName</b>. Hãy tham gia ngay các đợt thi thử THPT Quốc gia chuẩn 2025 để đánh giá và bứt phá điểm số!</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a asp-controller="Exam" asp-action="Schedule" class="btn btn-primary-custom btn-lg px-4"><i class="bi bi-pencil-square me-2"></i>Vào phòng thi ngay</a>
                        <a asp-controller="Exam" asp-action="History" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-clock-history me-2"></i>Xem lịch sử bài làm</a>
                    </div>
                }
                else
                {
                    <h2 class="text-white fw-bold mb-2">Sẵn sàng kiểm tra năng lực của bạn?</h2>
                    <p class="text-white-50 mb-4">Đăng ký tài khoản miễn phí để tham gia ngay các đợt thi thử THPT Quốc gia mở công khai</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom btn-lg px-4"><i class="bi bi-rocket-takeoff me-2"></i>Đăng ký miễn phí</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>