@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero -->
<section class="hero">
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge-gradient mb-3"><i class="bi bi-megaphone me-1"></i> Thi thử THPT Quốc gia miễn phí — mở đăng ký</span>
                <h1 class="mb-3">Kiểm tra — đánh giá chuẩn khoa học</h1>
                <p class="fs-5 mb-4">Hệ thống thi trắc nghiệm trực tuyến của trung tâm luyện thi: làm bài tính giờ, tự động lưu tiến trình, chấm điểm tức thì và phân tích kết quả chi tiết cho từng học viên.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Exam" asp-action="Schedule" class="btn btn-primary-custom btn-lg"><i class="bi bi-calendar-check me-2"></i>Xem lịch thi</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom btn-lg"><i class="bi bi-person-plus me-2"></i>Đăng ký thi thử miễn phí</a>
                </div>
                <div class="d-flex gap-4 mt-4 pt-2">
                    <div>
                        <h4 class="fw-bold mb-0">@Model.TotalExams</h4>
                        <small class="text-white-50">Kỳ thi / đề luyện</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">@Model.UpcomingExams</h4>
                        <small class="text-white-50">Đợt thi đang mở</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">@Model.CompletedExams</h4>
                        <small class="text-white-50">Bài đã hoàn thành</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <svg class="hero-art" viewBox="0 0 460 400" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Minh họa học sinh làm bài thi trắc nghiệm trực tuyến">
                    <defs>
                        <linearGradient id="hg1" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#01b4ff"/>
                            <stop offset="1" stop-color="#7c4dff"/>
                        </linearGradient>
                        <linearGradient id="hg2" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#ffffff" stop-opacity=".96"/>
                            <stop offset="1" stop-color="#e8efff" stop-opacity=".92"/>
                        </linearGradient>
                    </defs>
                    <!-- vòng tròn nền -->
                    <circle cx="230" cy="200" r="168" fill="#ffffff" fill-opacity=".06"/>
                    <circle cx="230" cy="200" r="122" fill="#ffffff" fill-opacity=".05"/>
                    <!-- cửa sổ trình duyệt -->
                    <rect x="70" y="72" width="320" height="240" rx="18" fill="url(#hg2)"/>
                    <rect x="70" y="72" width="320" height="40" rx="18" fill="#22335e"/>
                    <rect x="70" y="94" width="320" height="18" fill="#22335e"/>
                    <circle cx="96" cy="92" r="5.5" fill="#ff5f57"/>
                    <circle cx="114" cy="92" r="5.5" fill="#febc2e"/>
                    <circle cx="132" cy="92" r="5.5" fill="#28c840"/>
                    <rect x="150" y="86" width="180" height="12" rx="6" fill="#ffffff" fill-opacity=".18"/>
                    <!-- đồng hồ -->
                    <circle cx="118" cy="150" r="21" fill="#01b4ff"/>
                    <path d="M118 139v11l8 6" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    <!-- câu hỏi -->
                    <rect x="152" y="134" width="180" height="10" rx="5" fill="#2b3452" fill-opacity=".85"/>
                    <rect x="152" y="152" width="126" height="10" rx="5" fill="#2b3452" fill-opacity=".35"/>
                    <!-- 4 lựa chọn A-D -->
                    <g>
                        <rect x="94" y="186" width="132" height="26" rx="8" fill="#01b4ff" fill-opacity=".16"/>
                        <circle cx="110" cy="199" r="9" fill="#01b4ff"/>
                        <text x="110" y="203.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">A</text>
                        <rect x="126" y="193" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".45"/>
                        <rect x="238" y="186" width="132" height="26" rx="8" fill="#2b3452" fill-opacity=".08"/>
                        <circle cx="254" cy="199" r="9" fill="#2b3452" fill-opacity=".3"/>
                        <text x="254" y="203.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">B</text>
                        <rect x="270" y="193" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".25"/>
                        <rect x="94" y="220" width="132" height="26" rx="8" fill="#2b3452" fill-opacity=".08"/>
                        <circle cx="110" cy="233" r="9" fill="#2b3452" fill-opacity=".3"/>
                        <text x="110" y="237.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">C</text>
                        <rect x="126" y="227" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".25"/>
                        <rect x="238" y="220" width="132" height="26" rx="8" fill="#2b3452" fill-opacity=".08"/>
                        <circle cx="254" cy="233" r="9" fill="#2b3452" fill-opacity=".3"/>
                        <text x="254" y="237.5" text-anchor="middle" font-family="Arial" font-size="11" font-weight="bold" fill="#fff">D</text>
                        <rect x="270" y="227" width="88" height="12" rx="6" fill="#2b3452" fill-opacity=".25"/>
                    </g>
                    <rect x="94" y="262" width="276" height="30" rx="15" fill="url(#hg1)"/>
                    <text x="232" y="282" text-anchor="middle" font-family="Arial" font-size="13" font-weight="bold" fill="#fff">NỘP BÀI</text>
                    <!-- huy hiệu điểm -->
                    <g>
                        <circle cx="86" cy="316" r="38" fill="#ffffff"/>
                        <circle cx="86" cy="316" r="30" fill="url(#hg1)"/>
                        <text x="86" y="312" text-anchor="middle" font-family="Arial" font-size="17" font-weight="bold" fill="#fff">9.5</text>
                        <text x="86" y="328" text-anchor="middle" font-family="Arial" font-size="9" fill="#ffffff" fill-opacity=".85">điểm</text>
                    </g>
                    <!-- huy hiệu đạt -->
                    <g>
                        <circle cx="374" cy="318" r="30" fill="#ffffff"/>
                        <path d="M374 300l6 12 13 2-9.5 9 2.5 13-12-6.5-12 6.5 2.5-13-9.5-9 13-2z" fill="#28c76f"/>
                    </g>
                    <!-- mũi tên kết nối -->
                    <path d="M70 316 C 40 300, 40 260, 66 246" stroke="#ffffff" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 8" fill="none"/>
                    <path d="M394 290 C 420 270, 420 240, 396 228" stroke="#ffffff" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 8" fill="none"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title mb-2">Mô hình hoạt động</h2>
            <p class="section-subtitle">Học viên vẫn học tại lớp như thường lệ, kỳ thi được tổ chức trực tuyến</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card card-exam h-100 text-center">
                    <div class="card-body">
                        <span class="stat-icon mx-auto mb-3" style="background: var(--primary); width: 64px; height: 64px; font-size: 1.6rem;"><i class="bi bi-easel"></i></span>
                        <h5 class="fw-bold">1. Học Offline</h5>
                        <p class="text-muted small mb-0">Đến lớp theo lịch học buổi tối, nghe giảng và tương tác trực tiếp với giáo viên chuyên môn.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-exam h-100 text-center">
                    <div class="card-body">
                        <span class="stat-icon mx-auto mb-3" style="background: var(--gradient); width: 64px; height: 64px; font-size: 1.6rem;"><i class="bi bi-pencil-square"></i></span>
                        <h5 class="fw-bold">2. Thi Online</h5>
                        <p class="text-muted small mb-0">Kiểm tra 15 phút, bài tập về nhà, thi thử cuối tháng và thi thử THPT đều làm trực tuyến trên Website.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-exam h-100 text-center">
                    <div class="card-body">
                        <span class="stat-icon mx-auto mb-3" style="background: var(--success); width: 64px; height: 64px; font-size: 1.6rem;"><i class="bi bi-graph-up-arrow"></i></span>
                        <h5 class="fw-bold">3. Chấm điểm tự động</h5>
                        <p class="text-muted small mb-0">Hệ thống đếm giờ, thu bài, chấm điểm ngay lập tức; giáo viên theo dõi tiến bộ của từng học viên.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats -->
<section class="py-4" style="background: #fff;">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--gradient);"><i class="bi bi-calendar-event"></i></span>
                        <div>
                            <h3>@Model.TotalExams</h3>
                            <div class="stat-label">Tổng kỳ thi</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--primary);"><i class="bi bi-hourglass-split"></i></span>
                        <div>
                            <h3>@Model.UpcomingExams</h3>
                            <div class="stat-label">Sắp / đang mở</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--success);"><i class="bi bi-check2-circle"></i></span>
                        <div>
                            <h3>@Model.CompletedExams</h3>
                            <div class="stat-label">Đã hoàn thành</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="stat-icon" style="background: var(--accent2);"><i class="bi bi-trophy"></i></span>
                        <div>
                            <h3>@Model.AverageScore.ToString("0.0")</h3>
                            <div class="stat-label">Điểm trung bình</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest public exams -->
<section class="py-4">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between mb-4">
            <div>
                <h2 class="section-title mb-1">Thi thử THPT miễn phí</h2>
                <p class="section-subtitle mb-0">Đăng ký tài khoản để tham gia các đợt thi thử mở công khai, biết ngay năng lực hiện tại</p>
            </div>
            <a asp-controller="Exam" asp-action="Schedule" class="btn btn-outline-primary btn-sm rounded-pill">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
        </div>

        <div class="row g-4">
            @if (Model.LatestPublicExams.Any())
            {
                @foreach (var exam in Model.LatestPublicExams)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card card-exam h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="subject-badge"><i class="bi bi-book me-1"></i>@exam.SubjectName</span>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>@exam.Duration phút</small>
                                </div>
                                <h5 class="card-title fw-bold mb-2">@exam.Title</h5>
                                <p class="card-text text-muted small flex-grow-1">@exam.Description</p>
                                <div class="d-flex align-items-center justify-content-between mt-3">
                                    <small class="text-muted"><i class="bi bi-people me-1"></i>@exam.QuestionCount câu hỏi</small>
                                    <a asp-controller="Exam" asp-action="Detail" asp-route-id="@exam.Id" class="btn btn-sm btn-primary-custom">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="card border-0 rounded-4 shadow-sm">
                        <div class="card-body p-5 text-center text-muted">
                            <i class="bi bi-megaphone fs-1 d-block mb-3" style="color: var(--accent2); opacity: .45;"></i>
                            <h5 class="fw-bold">Đợt thi thử công khai sẽ sớm được mở</h5>
                            <p class="mb-0">Đăng ký tài khoản để nhận thông báo khi có đợt thi thử THPT Quốc gia miễn phí mới.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Features -->
<section class="py-5" style="background: #fff;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title mb-2">Trải nghiệm thi trực tuyến chuyên nghiệp</h2>
            <p class="section-subtitle">Đầy đủ tính năng phục vụ học viên chính thức và học sinh vãng lai</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="d-flex gap-3">
                    <span class="stat-icon" style="background: var(--gradient);"><i class="bi bi-alarm"></i></span>
                    <div>
                        <h6 class="fw-bold">Đồng hồ đếm ngược</h6>
                        <p class="text-muted small mb-0">Làm bài tính giờ như phòng thi thật, rèn luyện kỹ năng phân bổ thời gian dưới áp lực.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="d-flex gap-3">
                    <span class="stat-icon" style="background: var(--success);"><i class="bi bi-cloud-arrow-up"></i></span>
                    <div>
                        <h6 class="fw-bold">Tự động lưu tiến trình</h6>
                        <p class="text-muted small mb-0">Bài làm được lưu liên tục, an toàn khi gặp sự cố mạng, quay lại là làm tiếp được ngay.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="d-flex gap-3">
                    <span class="stat-icon" style="background: var(--accent2);"><i class="bi bi-check2-circle"></i></span>
                    <div>
                        <h6 class="fw-bold">Chấm điểm tức thì</h6>
                        <p class="text-muted small mb-0">Hệ thống tự động thu bài khi hết giờ, chấm điểm và hiển thị kết quả nếu trung tâm công bố điểm sớm.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="d-flex gap-3">
                    <span class="stat-icon" style="background: var(--primary);"><i class="bi bi-search"></i></span>
                    <div>
                        <h6 class="fw-bold">Tra cứu kết quả thi</h6>
                        <p class="text-muted small mb-0">Xem lịch sử các kỳ thi đã tham gia, tra cứu điểm số và chi tiết từng bài thi để đánh giá năng lực.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="d-flex gap-3">
                    <span class="stat-icon" style="background: var(--warning);"><i class="bi bi-calendar2-week"></i></span>
                    <div>
                        <h6 class="fw-bold">Lịch trình học tập</h6>
                        <p class="text-muted small mb-0">Theo dõi bài tập về nhà, lịch kiểm tra 15 phút và lịch thi thử cuối tháng được trung tâm phân công.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="d-flex gap-3">
                    <span class="stat-icon" style="background: var(--pink);"><i class="bi bi-phone"></i></span>
                    <div>
                        <h6 class="fw-bold">Hỗ trợ mọi thiết bị</h6>
                        <p class="text-muted small mb-0">Làm bài trên máy tính, tablet hay điện thoại — mở laptop là làm bài trực tuyến được ngay.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-5">
    <div class="container">
        <div class="card border-0 rounded-4" style="background: var(--gradient-dark);">
            <div class="card-body p-5 text-center">
                <h2 class="text-white fw-bold mb-2">Sẵn sàng kiểm tra năng lực của bạn?</h2>
                <p class="text-white-50 mb-4">Học sinh vãng lai đăng ký miễn phí để tham gia các đợt thi thử THPT Quốc gia mở công khai</p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom btn-lg px-4"><i class="bi bi-rocket-takeoff me-2"></i>Đăng ký miễn phí</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</section>