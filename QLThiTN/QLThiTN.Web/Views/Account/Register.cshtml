@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="card auth-card border-0">
                    <div class="row g-0">
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="auth-side h-100">
                                <div class="text-center mb-4">
                                    <span class="auth-logo mb-3"><i class="bi bi-mortarboard-fill"></i></span>
                                    <h4 class="fw-bold mt-3 mb-1">Bắt đầu ngay</h4>
                                    <p class="text-white-50 small mb-0">Miễn phí, chỉ mất 30 giây</p>
                                </div>
                                <ul class="list-unstyled text-white-50 small mt-4">
                                    <li class="mb-3"><i class="bi bi-check-circle-fill me-2 text-white"></i>Tiếp cận ngân hàng câu hỏi lớn</li>
                                    <li class="mb-3"><i class="bi bi-check-circle-fill me-2 text-white"></i>Tham gia kỳ thi online</li>
                                    <li class="mb-3"><i class="bi bi-check-circle-fill me-2 text-white"></i>Theo dõi tiến bộ của bạn</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form">
                                <h3 class="fw-bold mb-1">Tạo tài khoản mới</h3>
                                <p class="text-muted mb-4">Đăng ký để bắt đầu ôn luyện. Hệ thống sẽ gửi <strong>một email xác minh địa chỉ email</strong> — bạn bấm liên kết trong email thì tài khoản mới được tạo (gói miễn phí). Email nâng VIP là thư khác, chỉ gửi khi trung tâm cấp quyền đóng phí.</p>

                                <form asp-controller="Account" asp-action="Register" method="post">
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                    <div class="mb-3">
                                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-person-vcard"></i></span>
                                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
                                        </div>
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Username" class="form-label fw-semibold">Tên đăng nhập</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                            <input asp-for="Username" class="form-control" placeholder="Chọn tên đăng nhập" />
                                        </div>
                                        <span asp-validation-for="Username" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                                            <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                                                    <input asp-for="Password" class="form-control" placeholder="Ít nhất 6 ký tự" />
                                                </div>
                                                <span asp-validation-for="Password" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white"><i class="bi bi-lock-fill"></i></span>
                                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" />
                                                </div>
                                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary-custom w-100 btn-lg mb-3">
                                        <i class="bi bi-person-plus me-2"></i>Đăng ký
                                    </button>

                                    <div class="position-relative my-3 text-center">
                                        <hr class="text-muted opacity-25" />
                                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-medium">hoặc học viên vãng lai</span>
                                    </div>

                                    <a asp-action="ExternalLogin" asp-route-provider="Google"
                                       class="btn btn-google-login w-100 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm rounded-3 fw-semibold mb-3">
                                        <svg width="20" height="20" viewBox="0 0 48 48">
                                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                            <path fill="none" d="M0 0h48v48H0z"/>
                                        </svg>
                                        <span>Đăng nhập nhanh bằng Google</span>
                                    </a>

                                    <div class="text-center small text-muted">
                                        Đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}