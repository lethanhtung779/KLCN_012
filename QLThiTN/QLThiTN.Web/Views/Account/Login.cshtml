@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="card auth-card border-0">
                    <div class="row g-0">
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="auth-side h-100">
                                <div class="text-center mb-4">
                                    <span class="auth-logo mb-3"><i class="bi bi-mortarboard-fill"></i></span>
                                    <h4 class="fw-bold mt-3 mb-1">Ôn Thi THPT Quốc Gia</h4>
                                    <p class="text-white-50 small mb-0">Hệ thống thi trắc nghiệm trực tuyến</p>
                                </div>
                                <ul class="list-unstyled text-white-50 small mt-4">
                                    <li class="mb-3"><i class="bi bi-check-circle-fill me-2 text-white"></i>Ôn luyện mọi lúc mọi nơi</li>
                                    <li class="mb-3"><i class="bi bi-check-circle-fill me-2 text-white"></i>Đề thi chuẩn cấu trúc</li>
                                    <li class="mb-3"><i class="bi bi-check-circle-fill me-2 text-white"></i>Kết quả chấm điểm tức thì</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form">
                                <h3 class="fw-bold mb-1">Chào mừng trở lại!</h3>
                                <p class="text-muted mb-4">Đăng nhập để tiếp tục ôn luyện của bạn</p>

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                }

                                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                    <div class="mb-3">
                                        <label asp-for="Username" class="form-label fw-semibold">Tên đăng nhập</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                            <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" />
                                        </div>
                                        <span asp-validation-for="Username" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input asp-for="RememberMe" class="form-check-input" />
                                        <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label>
                                    </div>
                                    <button type="submit" class="btn btn-primary-custom w-100 btn-lg mb-3">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                                    </button>

                                    <div class="position-relative my-3 text-center">
                                        <hr class="text-muted opacity-25" />
                                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-medium">hoặc đăng nhập với</span>
                                    </div>

                                    <a asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@ViewBag.ReturnUrl"
                                       class="btn btn-google-login w-100 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm rounded-3 fw-semibold mb-3">
                                        <svg width="20" height="20" viewBox="0 0 48 48">
                                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                            <path fill="none" d="M0 0h48v48H0z"/>
                                        </svg>
                                        <span>Đăng nhập bằng Google</span>
                                    </a>

                                    <div class="text-center small text-muted">
                                        Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Đăng ký ngay</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}