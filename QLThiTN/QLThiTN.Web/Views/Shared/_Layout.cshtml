<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('qlthitn_theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-bs-theme', savedTheme);
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    <title>@ViewData["Title"] - Luyện Thi 247</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @* Font chinh ho tro dau tieng Viet day du *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />

    @* KaTeX: render nhanh phan lon cong thuc *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark main-nav shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="brand-icon shadow-sm"><i class="bi bi-mortarboard-fill"></i></span>
                <div class="d-flex flex-column ms-2">
                    <span class="fw-bold lh-1 fs-5" style="letter-spacing: -0.3px;">Luyện Thi 247 <span class="badge badge-pro">PRO</span></span>
                    <small class="text-white-50 d-none d-md-block" style="font-size: 0.7rem; letter-spacing: 0.2px;">Hệ thống Khảo thí & Luyện thi THPT</small>
                </div>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Trang chủ</a>
                    </li>
                    @if (Context.Session.GetString("UserRole") == "QuanTriVien")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminReview" asp-action="Index">Duyệt đề &amp; bài làm</a></li>
                    }
                    @if (Context.Session.GetString("UserRole") != "GiaoVien")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Exam" asp-action="Schedule"><i class="bi bi-calendar-event me-1"></i>Lịch thi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Exam" asp-action="KhoDe"><i class="bi bi-collection me-1"></i>Kho đề</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Exam" asp-action="History"><i class="bi bi-search me-1"></i>Tra cứu kết quả</a>
                        </li>
                        @if (Context.Session.GetString("UserFullName") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Exam" asp-action="LearningSchedule"><i class="bi bi-calendar2-week me-1"></i>Lịch trình học tập</a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link text-warning"><i class="bi bi-person-workspace me-1"></i>Khu vực Giáo viên</span>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center" id="themeToggleBtn" title="Chuyển chế độ Sáng / Tối" style="width: 36px; height: 36px;">
                        <i class="bi bi-moon-stars" id="themeToggleIcon"></i>
                    </button>

                    @if (Context.Session.GetString("UserFullName") != null)
                    {
                        string? _fullName = Context.Session.GetString("UserFullName");
                        <div class="dropdown">
                            <button class="btn btn-user dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                                <span class="user-avatar me-2">@(_fullName!.Substring(0, 1))</span>
                                <span class="user-name">@_fullName</span>
                                @if (Context.Session.GetInt32("HocVienId") != null)
                                {
                                    if (Context.Session.GetString("LoaiGoi") == "DongPhi")
                                    {
                                        <span class="badge badge-vip ms-2"><i class="bi bi-patch-check-fill me-1"></i>VIP</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-free ms-2">Miễn phí</span>
                                    }
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li><a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm me-1 rounded-pill px-3">Đăng nhập</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom btn-sm rounded-pill px-3">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (Context.Session.GetString("UserRole") == "GiaoVien")
    {
        <div class="alert alert-info border-0 rounded-0 mb-0 py-2 text-center small">
            <i class="bi bi-info-circle me-1"></i>Bạn đang đăng nhập bằng tài khoản <strong>Giáo viên</strong>. Để quản lý ngân hàng câu hỏi, tạo đề và xem thống kê, vui lòng sử dụng phần mềm <strong>QLThiTN trên máy tính</strong>.
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer footer mt-auto py-4 text-light">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold"><i class="bi bi-mortarboard-fill me-2"></i>Luyện Thi 247</h5>
                    <p class="text-white-50 mb-0">Hệ thống quản lý và thi trắc nghiệm trực tuyến — giúp kiểm tra – đánh giá chính xác cho mọi học viên.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-uppercase mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="footer-link">Trang chủ</a></li>
                        @if (Context.Session.GetString("UserRole") != "GiaoVien")
                        {
                            <li class="mb-2"><a asp-controller="Exam" asp-action="Schedule" class="footer-link">Lịch thi</a></li>
                            <li class="mb-2"><a asp-controller="Exam" asp-action="KhoDe" class="footer-link">Kho đề</a></li>
                            <li class="mb-2"><a asp-controller="Exam" asp-action="History" class="footer-link">Tra cứu kết quả</a></li>
                            <li class="mb-2"><a asp-controller="Exam" asp-action="LearningSchedule" class="footer-link">Lịch trình học tập</a></li>
                        }
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-uppercase mb-3">Liên hệ</h6>
                    <ul class="list-unstyled small text-white-50 mb-0">
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i>support@onthithpt.vn</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2"></i>1900 1234</li>
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i>Hà Nội, Việt Nam</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4">
            <div class="text-center small text-white-50">
                &copy; @DateTime.Now.Year - Luyện Thi 247
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/latex.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
